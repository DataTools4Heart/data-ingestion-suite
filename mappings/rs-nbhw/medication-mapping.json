{
  "id" : "medication-mapping",
  "url" : "https://datatools4heart.eu/fhir/mappings/rs-nbhw/medication-mapping",
  "name" : "medication-mapping",
  "title" : "Medication mapping",
  "isDraft" : false,
  "source" : [ {
    "alias" : "source",
    "url" : "https://datatools4heart.eu/fhir/schemas/rs-nbhw/MedicationRequest",
    "joinOn" : [ ]
  } ],
  "context" : { },
  "variable" : [ ],
  "mapping" : [ {
    "expression" : {
      "name" : "result",
      "language" : "application/fhir-template+json",
      "value" : {
        "id" : "{{mpp:getHashedId('MedicationRequest', 'nbhw' & identifier)}}",
        "meta" : {
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-MedicationRequest" ]
        },
        "resourceType" : "MedicationRequest",
        "medication" : {
          "concept" : {
            "coding" : [ {
              "system" : "http://www.whocc.no/atc",
              "code" : "{{code}}",
              "@sliceName" : "atcCode"
            } ]
          }
        },
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', subject.toString())}}",
        "identifier" : [ {
          "value" : "{{identifier}}"
        } ],
        "status" : "completed",
        "intent" : "order",
        "effectiveDosePeriod" : {
          "start" : "{{Date}}"
        },
        "dosageInstruction" : [ {
          "timing" : {
            "repeat" : {
              "frequency" : "{{? freq_int}}",
              "period" : "{{? period_scaled}}",
              "periodUnit" : "{{? iif(period_scaled.exists(), periodUnit)}}"
            }
          },
          "asNeeded" : "{{iif(asNeeded = 1, true, false)}}",
          "doseAndRate" : [ {
            "doseQuantity" : {
              "value" : "{{? dose}}",
              "unit" : "{{? doseUnit}}"
            }
          } ]
        } ]
      }
    }
  } ]
}