{
  "id" : "vital-sign-mapping",
  "url" : "https://datatools4heart.eu/fhir/mappings/umcu-uc2/vital-sign-mapping",
  "name" : "vital-sign-mapping",
  "title" : "Mapping of UMCU's vitalsign table to HFR-VitalSign FHIR profile",
  "isDraft" : false,
  "source" : [ {
    "alias" : "source",
    "url" : "https://datatools4heart.eu/fhir/schemas/umcu-uc2/VitalSign",
    "joinOn" : [ "studyId_0919" ]
  }, {
    "alias" : "encounters",
    "url" : "https://datatools4heart.eu/fhir/schemas/umcu-uc2/Encounter",
    "joinOn" : [ "studyId_0919" ]
  } ],
  "context" : {
    "vitalSignMap" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/umcu-uc2/vital-sign-concept-map.csv"
    }
  },
  "variable" : [ {
    "name" : "effectiveDate",
    "language" : "text/fhirpath",
    "expression" : "effectiveDateTime.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd')"
  }, {
    "name" : "relatedEncounter",
    "language" : "text/fhirpath",
    "expression" : " %encounters.where(period_start.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') <= %effectiveDate and period_end.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') >= %effectiveDate).first() "
  } ],
  "mapping" : [ {
    "precondition" : {
      "name" : "valueExists",
      "language" : "text/fhirpath",
      "expression" : "ValueQuantity.exists()"
    },
    "expression" : {
      "name" : "result",
      "language" : "application/fhir-template+json",
      "value" : {
        "id" : "{{mpp:getHashedId('Observation', studyId_0919.toString() & identifier_value.toString() & LOINCcode & effectiveDateTime.toString() & ValueQuantity.toString())}}",
        "meta" : {
          "source" : "{{%sourceSystem.sourceUri}}",
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign" ]
        },
        "resourceType" : "Observation",
        "category" : [ {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/observation-category",
            "code" : "vital-signs",
            "display" : "Vital Signs"
          } ]
        } ],
        "code" : {
          "coding" : [ {
            "system" : "http://loinc.org",
            "code" : "{{mpp:getConcept(%vitalSignMap, LOINCcode, 'target_code')}}",
            "display" : "{{mpp:getConcept(%vitalSignMap, LOINCcode, 'target_display')}}",
            "@sliceName" : "loincCode"
          } ]
        },
        "effectiveDateTime" : "{{effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss')}}",
        "valueQuantity" : {
          "system" : "http://unitsofmeasure.org",
          "code" : "{{mpp:getConcept(%vitalSignMap, LOINCcode, 'target_code')}}",
          "value" : "{{? iif(ValueQuantity.exists() and ValueQuantity != '', ValueQuantity)}}",
          "unit" : "{{mpp:getConcept(%vitalSignMap, LOINCcode, 'target_unit')}}"
        },
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', studyId_0919.toString())}}",
        "encounter" : "{{? mpp:createFhirReferenceWithHashedId('Encounter', %relatedEncounter.identifier_value)}}",
        "identifier" : [ {
          "value" : "{{ studyId_0919.toString() & '-' & identifier_value.toString() & '-' & LOINCcode & '-' & effectiveDateTime.toString() & '-' & ValueQuantity.toString() }}"
        } ],
        "status" : "final"
      }
    }
  } ]
}