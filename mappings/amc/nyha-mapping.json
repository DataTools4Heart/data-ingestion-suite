{
  "id" : "nyha-mapping",
  "url" : "https://datatools4heart.eu/fhir/mappings/amc/nyha-mapping",
  "name" : "nyha-mapping",
  "title" : "Mapping of NYHA table",
  "isDraft" : false,
  "source" : [ {
    "alias" : "source",
    "url" : "https://datatools4heart.eu/fhir/schemas/amc/NYHA",
    "joinOn" : [ "pseudo_id" ]
  }, {
    "alias" : "encounters",
    "url" : "https://datatools4heart.eu/fhir/schemas/amc/encounter",
    "joinOn" : [ "Pseudo_id" ]
  } ],
  "context" : {
    "nyhaMap" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/amc/nyha-map.csv"
    }
  },
  "variable" : [ {
    "name" : "effectiveDate",
    "language" : "text/fhirpath",
    "expression" : "dateNote.first().substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd')"
  }, {
    "name" : "relatedEncounter",
    "language" : "text/fhirpath",
    "expression" : " %encounters.where(PrimaryICDcode.exists() and PrimaryICDcode != '' and EndDate.substring(0, 10) != '1900-01-01').where(StartDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') <= %effectiveDate and EndDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') >= %effectiveDate).nav:orElse(%encounters.where(PrimaryICDcode.exists() and PrimaryICDcode != '').where(StartDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') = %effectiveDate)).first() "
  }, {
    "name" : "relatedEncounterSecondary",
    "language" : "text/fhirpath",
    "expression" : " iif(%relatedEncounter.empty(), %encounters.where(StartDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') <= %effectiveDate and EndDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') >= %effectiveDate).nav:orElse(%encounters.where(StartDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') = %effectiveDate))).first() "
  } ],
  "mapping" : [ {
    "expression" : {
      "name" : "result",
      "language" : "application/fhir-template+json",
      "value" : {
        "id" : "{{mpp:getHashedId('Observation', pseudo_id.toString() & dateNote.toString() & nyha.toString())}}",
        "meta" : {
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-NYHAAssessment" ]
        },
        "resourceType" : "Observation",
        "category" : [ {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/observation-category",
            "code" : "exam",
            "display" : "Exam"
          } ]
        } ],
        "code" : {
          "coding" : [ {
            "system" : "http://loinc.org",
            "code" : "88020-3",
            "display" : "Functional capacity NYHA",
            "@sliceName" : "loincCode"
          } ]
        },
        "effectiveDateTime" : "{{dateNote.first().utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss')}}",
        "valueCodeableConcept" : {
          "coding" : [ {
            "system" : "http://loinc.org",
            "code" : "{{mpp:getConcept(%nyhaMap, nyha.toString(), 'target_code')}}",
            "display" : "{{mpp:getConcept(%nyhaMap, nyha.toString(), 'target_display')}}"
          } ]
        },
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', pseudo_id.toString())}}",
        "encounter" : "{{? iif(%relatedEncounter.exists(), mpp:createFhirReferenceWithHashedId('Encounter', %relatedEncounter.PatientContactId), mpp:createFhirReferenceWithHashedId('Encounter', %relatedEncounterSecondary.PatientContactId) )}}",
        "identifier" : [ {
          "value" : "{{pseudo_id.toString() & '-' & dateNote.toString() & '-' & nyha.toString()}}"
        } ],
        "status" : "final"
      }
    }
  } ]
}