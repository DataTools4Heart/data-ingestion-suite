{
  "id" : "laboratory-mapping",
  "url" : "https://datatools4heart.eu/fhir/mappings/amc/laboratory-mapping",
  "name" : "laboratory-mapping",
  "title" : "Mapping of AMC's Laboratory table to DT4H-LabResult FHIR profile",
  "isDraft" : false,
  "source" : [ {
    "alias" : "source",
    "url" : "https://datatools4heart.eu/fhir/schemas/amc/Laboratory",
    "joinOn" : [ "Pseudo_id" ]
  }, {
    "alias" : "encounters",
    "url" : "https://datatools4heart.eu/fhir/schemas/amc/encounter",
    "joinOn" : [ "Pseudo_id" ]
  } ],
  "context" : {
    "labCodeConversion" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/amc/lab-result-concept-map.csv"
    }
  },
  "variable" : [ {
    "name" : "effectiveDate",
    "language" : "text/fhirpath",
    "expression" : "MateriaalAfnameDatumTijd.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd')"
  }, {
    "name" : "coveringEncounters",
    "language" : "text/fhirpath",
    "expression" : "%encounters.where(StartDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') <= %effectiveDate and EndDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') >= %effectiveDate)"
  }, {
    "name" : "sameDayEncounters",
    "language" : "text/fhirpath",
    "expression" : "%encounters.where(StartDate.substring(0, 10).utl:toFhirDateTime('yyyy-MM-dd') = %effectiveDate)"
  }, {
    "name" : "relatedEncounter",
    "language" : "text/fhirpath",
    "expression" : "%coveringEncounters.where(PrimaryICDcode.exists() and PrimaryICDcode != '' and EndDate.substring(0, 10) != '1900-01-01').nav:orElse(%sameDayEncounters.where(PrimaryICDcode.exists() and PrimaryICDcode != '')).first()"
  }, {
    "name" : "relatedEncounterSecondary",
    "language" : "text/fhirpath",
    "expression" : "%coveringEncounters.nav:orElse(%sameDayEncounters).first()"
  }, {
    "name" : "linkedEncounter",
    "language" : "text/fhirpath",
    "expression" : "%relatedEncounter.nav:orElse(%relatedEncounterSecondary)"
  }, {
    "name" : "labConcept",
    "language" : "text/fhirpath",
    "expression" : "mpp:getConcept(%labCodeConversion, LOINC_code).first()"
  }, {
    "name" : "labQuantity",
    "language" : "text/fhirpath",
    "expression" : "mpp:convertAndReturnQuantity(%labCodeConversion, LOINC_code.toString(), UitslagNumeriek, UitslagEenheid.toString())"
  }, {
    "name" : "referenceLow",
    "language" : "text/fhirpath",
    "expression" : "iif(NormaalwaardeOndergrens.exists() and NormaalwaardeOndergrens != '', NormaalwaardeOndergrens.replace(',', '.').replaceMatches('[<>]', '').toDecimal())"
  }, {
    "name" : "referenceHigh",
    "language" : "text/fhirpath",
    "expression" : "iif(NormaalwaardeBovengrens.exists() and NormaalwaardeBovengrens != '', NormaalwaardeBovengrens.replace(',', '.').replaceMatches('[<>]', '').toDecimal())"
  }, {
    "name" : "troponinTValueNgL",
    "language" : "text/fhirpath",
    "expression" : "iif(%labConcept.target_code in ('6598-7' | '67151-1' | '6597-9'), iif(%labQuantity.code = 'ng/L', %labQuantity.value, iif(%labQuantity.code = 'mcg/L' or %labQuantity.code = 'ug/L', %labQuantity.value * 1000, {})), {})"
  }, {
    "name" : "troponinTInterpretation",
    "language" : "text/fhirpath",
    "expression" : "iif(%troponinTValueNgL.exists(), iif(%troponinTValueNgL > 14, 'H', 'N'), {})"
  } ],
  "mapping" : [ {
    "description" : "One HFR-LabResult per Laboratory row. Code, display and value come from lab-result-concept-map.csv (value converted to the target unit). The encounter is the one covering the sample date with a primary ICD code (or one starting that day with a primary ICD code); otherwise any encounter covering or starting on that date. Troponin T (6598-7, 67151-1, 6597-9) gets an interpretation: H if the value is above 14 ng/L, otherwise N.",
    "expression" : {
      "name" : "result",
      "language" : "application/fhir-template+json",
      "value" : {
        "id" : "{{mpp:getHashedId('Observation', UitslagId)}}",
        "meta" : {
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-LabResult" ]
        },
        "resourceType" : "Observation",
        "status" : "final",
        "category" : [ {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/observation-category",
            "code" : "laboratory",
            "display" : "Laboratory"
          } ]
        } ],
        "code" : {
          "coding" : [ {
            "system" : "http://loinc.org",
            "code" : "{{%labConcept.target_code}}",
            "display" : "{{%labConcept.target_display}}",
            "@sliceName" : "loincCode"
          } ]
        },
        "effectiveDateTime" : "{{MateriaalAfnameDatumTijd.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss')}}",
        "valueQuantity" : "{{? %labQuantity}}",
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', Pseudo_id.toString())}}",
        "encounter" : "{{? mpp:createFhirReferenceWithHashedId('Encounter', %linkedEncounter.PatientContactId)}}",
        "identifier" : [ {
          "value" : "{{UitslagId}}"
        } ],
        "referenceRange" : [ {
          "low" : {
            "value" : "{{? %referenceLow}}"
          },
          "high" : {
            "value" : "{{? %referenceHigh}}"
          }
        } ],
        "interpretation" : [ {
          "{{#interpretationCode}}" : "{{%troponinTInterpretation}}",
          "{{?}}" : {
            "coding" : [ {
              "system" : "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation",
              "code" : "{{%interpretationCode}}"
            } ]
          }
        } ]
      }
    }
  } ]
}