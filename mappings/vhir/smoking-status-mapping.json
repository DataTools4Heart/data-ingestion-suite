{
  "id" : "smoking-status-mapping",
  "url" : "https://datatools4heart.eu/fhir/mappings/vhir/smoking-status-mapping",
  "name" : "smoking-status-mapping",
  "title" : "Mapping of SIDIAP OMOP observations having concept_id = 43054909 to DT4H-SmokingStatus profile",
  "isDraft" : false,
  "source" : [ {
    "alias" : "observation",
    "url" : "https://www.vallhebron.com/fhir/StructureDefinition/OMOP-Observation",
    "joinOn" : [ "PERSON_ID" ]
  }, {
    "alias" : "omopVisit",
    "url" : "https://www.vallhebron.com/fhir/StructureDefinition/OMOP-VisitOccurrence",
    "joinOn" : [ "PERSON_ID" ]
  } ],
  "context" : {
    "smokingStatusOmopConceptMap" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/vhir/smoking-status-omop-concept-map.csv"
    }
  },
  "variable" : [ ],
  "mapping" : [ {
    "description" : "Mapping of SIDIAP OMOP observation (OBSERVATION_CONCEPT_ID 43054909, one row per smoking period) to the DT4H smoking status profile. The value comes from VALUE_AS_CONCEPT_ID (smoking-status-omop-concept-map.csv); rows with an unknown value are skipped. Vall d'Hebron smoking (MEASUREMENT 4062492) is not ingested, as VHIR requested.",
    "precondition" : {
      "name" : "isSmokingStatus",
      "language" : "text/fhirpath",
      "expression" : "OBSERVATION_CONCEPT_ID = 43054909 and mpp:getConcept(%smokingStatusOmopConceptMap, VALUE_AS_CONCEPT_ID.toString()).exists()"
    },
    "expression" : {
      "name" : "smoking",
      "language" : "application/fhir-template+json",
      "value" : {
        "id" : "{{mpp:getHashedId('Observation', ID_PREFIX & OBSERVATION_ID.toString())}}",
        "meta" : {
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-SmokingStatus" ]
        },
        "resourceType" : "Observation",
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', PERSON_ID.toString())}}",
        "encounter" : "{{? %omopVisit.select(iif($this.VISIT_START_DATE <= %context.OBSERVATION_DATE and $this.VISIT_END_DATE >= %context.OBSERVATION_DATE, mpp:createFhirReferenceWithHashedId('Encounter', $this.VISIT_OCCURRENCE_ID.toString()),{})).first()}}",
        "effectivePeriod" : {
          "start" : "{{iif(OBSERVATION_DATETIME.exists(),OBSERVATION_DATETIME.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd HH:mm:ss.S'),OBSERVATION_DATE)}}"
        },
        "category" : [ {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/observation-category",
            "code" : "social-history",
            "display" : "Social History"
          } ]
        } ],
        "code" : {
          "coding" : [ {
            "system" : "http://loinc.org",
            "code" : "72166-2",
            "display" : "Tobacco smoking status",
            "@sliceName" : "loincCode"
          } ]
        },
        "valueCodeableConcept" : {
          "{{#concept}}" : "{{mpp:getConcept(%smokingStatusOmopConceptMap, VALUE_AS_CONCEPT_ID.toString())}}",
          "{{?}}" : "{{utl:createFhirCodeableConcept(%concept.target_system, %concept.target_code, %concept.target_display)}}"
        },
        "status" : "final"
      }
    }
  } ]
}