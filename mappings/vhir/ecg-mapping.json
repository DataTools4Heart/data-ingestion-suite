{
  "id" : "ecg-mapping",
  "url" : "https://datatools4heart.eu/fhir/mappings/vhir/ecg-mapping",
  "name" : "ecg-mapping",
  "title" : "Mapping of OMOP measurement ECG parameters to DT4H Electrocardiograph profile",
  "isDraft" : false,
  "source" : [ {
    "alias" : "omopMeasurement",
    "url" : "https://www.vallhebron.com/fhir/StructureDefinition/OMOP-Measurement",
    "joinOn" : [ "PERSON_ID" ]
  }, {
    "alias" : "omopVisit",
    "url" : "https://www.vallhebron.com/fhir/StructureDefinition/OMOP-VisitOccurrence",
    "joinOn" : [ "PERSON_ID" ]
  } ],
  "context" : {
    "ecgCodeConversion" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/vhir/ecg-omop-to-loinc-concept-map.csv"
    }
  },
  "variable" : [ ],
  "mapping" : [ {
    "description" : "One HFR-Electrocardiograph Observation per ECG. VHIR stores each ECG parameter as a separate MEASUREMENT row; the job's preprocessSql groups the rows of one patient into arrays (MEASUREMENT_CONCEPT_ID, VALUE_AS_NUMBER) by MEASUREMENT_DATETIME, or by MEASUREMENT_DATE for rows without a time (MEASUREMENT_DATETIME is optional), so several ECGs on one day stay separate panels. For a group without a time, MEASUREMENT_DATETIME is empty and effectiveDateTime falls back to MEASUREMENT_DATE. Exact duplicate rows (same parameter and value in a group) are removed; different values for the same parameter are all kept as components. Each array element becomes a component, coded with ecg-omop-to-loinc-concept-map.csv; elements whose concept is not in that map are skipped.",
    "precondition" : {
      "name" : "hasEcgComponent",
      "language" : "text/fhirpath",
      "expression" : "MEASUREMENT_CONCEPT_ID.where(mpp:getConcept(%ecgCodeConversion, $this.toString()).exists()).exists()"
    },
    "expression" : {
      "name" : "ecg",
      "language" : "application/fhir-template+json",
      "value" : {
        "id" : "{{mpp:getHashedId('Observation', PERSON_ID.toString() & '|' & (MEASUREMENT_DATETIME | MEASUREMENT_DATE).first().toString() & 'ecg')}}",
        "meta" : {
          "source" : "{{%sourceSystem.sourceUri}}",
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Electrocardiograph" ]
        },
        "resourceType" : "Observation",
        "status" : "final",
        "category" : [ {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/observation-category",
            "code" : "vital-signs",
            "display" : "Vital Signs"
          } ]
        } ],
        "code" : {
          "coding" : [ {
            "system" : "http://loinc.org",
            "code" : "34534-8",
            "display" : "12 lead EKG panel",
            "@sliceName" : "loincCode"
          } ]
        },
        "effectiveDateTime" : "{{iif(MEASUREMENT_DATETIME.exists(), MEASUREMENT_DATETIME.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd HH:mm:ss.S'), MEASUREMENT_DATE.utl:toFhirDate('yyyy-MM-dd'))}}",
        "component" : {
          "{{#ind}}" : "{{utl:indices(0, count.toInteger() - 1)}}",
          "{{*}}" : {
            "{{#ecgCode}}" : "{{mpp:getConcept(%ecgCodeConversion, MEASUREMENT_CONCEPT_ID[%ind].toString())}}",
            "{{?}}" : {
              "code" : {
                "coding" : [ {
                  "system" : "http://loinc.org",
                  "code" : "{{%ecgCode.target_code}}",
                  "display" : "{{%ecgCode.target_display}}"
                } ]
              },
              "valueQuantity" : {
                "value" : "{{VALUE_AS_NUMBER[%ind]}}",
                "unit" : "{{iif(%ecgCode.target_unit = 'ms', 'millisecond', iif(%ecgCode.target_unit = 'deg', 'degree', %ecgCode.target_unit))}}",
                "system" : "http://unitsofmeasure.org",
                "code" : "{{%ecgCode.target_unit}}"
              }
            }
          }
        },
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', PERSON_ID.toString())}}",
        "encounter" : "{{? %omopVisit.select(iif($this.VISIT_START_DATE <= %context.MEASUREMENT_DATE and $this.VISIT_END_DATE >= %context.MEASUREMENT_DATE, mpp:createFhirReferenceWithHashedId('Encounter', $this.VISIT_OCCURRENCE_ID.toString()),{})).first()}}"
      }
    }
  } ]
}
