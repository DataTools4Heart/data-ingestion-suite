{
  "id" : "diagnoses-icd",
  "url" : "https://mimic.mit.edu/fhir/mappings/diagnoses-icd",
  "name" : "diagnoses-icd",
  "title" : "Mapping of entries in 'diagnoses_icd' table joined with 'd_icd_diagnoses' table restructured as FHIR concept map in MIMIC-IV v3.1 dataset into FHIR Condition resources. ICD-9-CM codes are translated to ICD-10-CM through the CMS General Equivalence Mappings (GEM); rows whose ICD-9-CM code has no GEM equivalent are skipped because HFR-Condition requires an ICD-10 coding.",
  "isDraft" : false,
  "source" : [ {
    "alias" : "diagnoses",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-diagnoses-icd",
    "joinOn" : [ "icd_version", "icd_code", "hadm_id" ]
  }, {
    "alias" : "icdConceptMap",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-d-icd-diagnoses",
    "joinOn" : [ "icd_version", "icd_code" ]
  }, {
    "alias" : "admissions",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-admissions",
    "joinOn" : [ null, null, "hadm_id" ]
  } ],
  "context" : {
    "icd9to10Map" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/mimic/icd9toicd10cmgem.csv"
    }
  },
  "variable" : [ {
    "name" : "icd10Code",
    "language" : "text/fhirpath",
    "expression" : "iif(icd_version=9, mpp:getConcept(%icd9to10Map, icd_code).where(combination='0' and no_map='0').nav:orElse(iif(icd_code.length()>4, mpp:getConcept(%icd9to10Map, icd_code.substring(0,4)).where(combination='0' and no_map='0').nav:orElse(mpp:getConcept(%icd9to10Map, icd_code.substring(0,3)).where(combination='0' and no_map='0')), iif(icd_code.length()=4, mpp:getConcept(%icd9to10Map, icd_code.substring(0,3)).where(combination='0' and no_map='0'), {}))).last(),{})"
  }, {
    "name" : "icdDisplay",
    "language" : "text/fhirpath",
    "expression" : "%icdConceptMap.first().long_title"
  } ],
  "mapping" : [ {
    "precondition" : {
      "name" : "icd10CodeExists",
      "language" : "text/fhirpath",
      "expression" : "%icd10Code.exists() or icd_version = 10"
    },
    "expression" : {
      "name" : "condition-mapping",
      "language" : "application/fhir-template+json",
      "value" : {
        "resourceType" : "Condition",
        "id" : "{{mpp:getHashedId('Condition',hadm_id.toString() & seq_num.toString())}}",
        "meta" : {
          "source" : "{{%sourceSystem.sourceUri}}",
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Condition" ]
        },
        "identifier" : [ {
          "use" : "official",
          "system" : "{{%sourceSystem.sourceUri}}/fhir/diagnoses_icd_ids",
          "value" : "{{hadm_id.toString() & '-' & seq_num.toString()}}"
        } ],
        "clinicalStatus" : {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/condition-clinical",
            "code" : "active"
          } ]
        },
        "category" : [ {
          "coding" : [ {
            "system" : "http://terminology.hl7.org/CodeSystem/condition-category",
            "code" : "encounter-diagnosis",
            "display" : "Encounter diagnosis"
          } ]
        } ],
        "code" : {
          "coding" : [ {
            "{{#isIcd10}}" : "{{iif(icd_version = 10, true, {})}}",
            "{{?}}" : {
              "system" : "http://hl7.org/fhir/sid/icd-10",
              "code" : "{{iif(icd_code.length() > 3, icd_code.substring(0,3) & '.' & icd_code.substring(3), icd_code)}}",
              "display" : "{{? %icdDisplay}}"
            },
            "@sliceName" : "icd10Code"
          }, {
            "{{#isIcd9}}" : "{{iif(icd_version = 9, true, {})}}",
            "{{?}}" : {
              "system" : "http://hl7.org/fhir/sid/icd-9-cm",
              "code" : "{{iif(icd_code.length()=3 or (icd_code.startsWith('E') and icd_code.length()=4), icd_code, iif(icd_code.startsWith('E'), icd_code.substring(0,4) & '.' & icd_code.substring(4), icd_code.substring(0,3) & '.' & icd_code.substring(3)))}}",
              "display" : "{{? %icdDisplay}}"
            }
          }, {
            "{{#gemConcept}}" : "{{%icd10Code}}",
            "{{?}}" : {
              "system" : "http://hl7.org/fhir/sid/icd-10",
              "code" : "{{iif(%gemConcept.icd10cm.length()>3, %gemConcept.icd10cm.substring(0,3) & '.' & %gemConcept.icd10cm.substring(3), %gemConcept.icd10cm)}}"
            },
            "@sliceName" : "icd10Code"
          } ],
          "text" : "{{? %icdDisplay}}"
        },
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', subject_id.toString())}}",
        "encounter" : "{{mpp:createFhirReferenceWithHashedId('Encounter', hadm_id.toString())}}",
        "onsetDateTime" : "{{? %admissions.first().admittime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')}}",
        "recordedDate" : "{{? %admissions.first().dischtime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')}}",
        "extension" : [ {
          "url" : "https://mimic.mit.edu/fhir/StructureDefinition/ext-diagnosis-seq-num",
          "valueInteger" : "{{seq_num}}"
        } ]
      }
    }
  } ]
}
