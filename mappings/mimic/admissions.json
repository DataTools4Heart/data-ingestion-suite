{
  "id" : "admissions",
  "url" : "https://mimic.mit.edu/fhir/mappings/admissions",
  "name" : "admissions",
  "title" : "Mapping of entries in 'admissions' table joined with 'diagnoses_icd', 'transfers' and 'services' in MIMIC-IV v3.1 dataset into FHIR Encounter resources. The principal (seq_num = 1) billing diagnosis is used as the admitting diagnosis of the HFR-Encounter profile.",
  "isDraft" : false,
  "source" : [ {
    "alias" : "admissions",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-admissions",
    "joinOn" : [ "hadm_id" ]
  }, {
    "alias" : "diagnoses",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-diagnoses-icd",
    "joinOn" : [ "hadm_id" ]
  }, {
    "alias" : "transfers",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-transfers",
    "joinOn" : [ "hadm_id" ]
  }, {
    "alias" : "services",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-services",
    "joinOn" : [ "hadm_id" ]
  } ],
  "context" : {
    "admissionTypeConceptMap" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/mimic/admission-type-concept-map.csv"
    }
  },
  "variable" : [ {
    "name" : "encClass",
    "language" : "text/fhirpath",
    "expression" : "mpp:getConcept(%admissionTypeConceptMap, admission_type).first()"
  }, {
    "name" : "serviceCodes",
    "language" : "text/fhirpath",
    "expression" : "%services.curr_service.distinct()"
  } ],
  "mapping" : [ {
    "expression" : {
      "name" : "admissions-to-encounter-mapping",
      "language" : "application/fhir-template+json",
      "value" : {
        "resourceType" : "Encounter",
        "id" : "{{mpp:getHashedId('Encounter',hadm_id.toString())}}",
        "meta" : {
          "source" : "{{%sourceSystem.sourceUri}}",
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Encounter" ]
        },
        "identifier" : [ {
          "use" : "official",
          "system" : "{{%sourceSystem.sourceUri}}/fhir/hadm_ids",
          "value" : "{{hadm_id.toString()}}"
        } ],
        "status" : "completed",
        "class" : [ {
          "coding" : [ {
            "system" : "{{%encClass.target_system}}",
            "code" : "{{%encClass.target_class}}",
            "display" : "{{%encClass.target_class_display}}"
          } ],
          "text" : "{{admission_type}}"
        } ],
        "priority" : {
          "{{#prio}}" : "{{%encClass.target_priority.where($this != '')}}",
          "{{?}}" : {
            "coding" : [ {
              "system" : "http://terminology.hl7.org/CodeSystem/v3-ActPriority",
              "code" : "{{%prio}}",
              "display" : "{{%encClass.target_priority_display}}"
            } ]
          }
        },
        "type" : [ {
          "coding" : [ {
            "system" : "https://mimic.mit.edu/fhir/CodeSystem/admission-types",
            "code" : "{{admission_type}}",
            "display" : "{{admission_type}}"
          } ]
        }, {
          "{{#stype}}" : "{{%serviceCodes}}",
          "{{*}}" : {
            "coding" : [ {
              "system" : "https://mimic.mit.edu/fhir/CodeSystem/services",
              "code" : "{{%stype}}",
              "display" : "{{trms:lookupDisplay(%stype,'https://mimic.mit.edu/fhir/CodeSystem/services', {})}}"
            } ]
          }
        } ],
        "serviceType" : {
          "{{#svc}}" : "{{%serviceCodes}}",
          "{{*}}" : {
            "concept" : {
              "coding" : [ "{{* trms:translateToCoding(%svc, 'https://mimic.mit.edu/fhir/CodeSystem/services','https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/services-to-snomed')}}" ],
              "text" : "{{trms:lookupDisplay(%svc,'https://mimic.mit.edu/fhir/CodeSystem/services', {})}}"
            }
          }
        },
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', subject_id.toString())}}",
        "actualPeriod" : {
          "start" : "{{admittime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')}}",
          "end" : "{{dischtime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')}}"
        },
        "length" : "{{utl:getDurationAsQuantityObject(admittime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00'), dischtime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00'))}}",
        "admission" : {
          "admitSource" : {
            "{{#hasAdmitSource}}" : "{{iif(edregtime.exists() or admission_location.exists(), true)}}",
            "{{?}}" : {
              "coding" : "{{* iif(edregtime.exists(), utl:createFhirCoding('http://terminology.hl7.org/CodeSystem/admit-source', 'emd', 'From accident/emergency department'), trms:translateToCoding(admission_location, 'https://mimic.mit.edu/fhir/CodeSystem/admission-locations','https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/admission-location-to-hl7'))}}",
              "text" : "{{? admission_location}}"
            }
          },
          "dischargeDisposition" : {
            "{{#dscl}}" : "{{iif(hospital_expire_flag=1,'DIED',discharge_location)}}",
            "{{?}}" : {
              "coding" : "{{* trms:translateToCoding(%dscl, 'https://mimic.mit.edu/fhir/CodeSystem/discharge-locations','https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/discharge-location-to-hl7')}}",
              "text" : "{{%dscl}}"
            }
          }
        },
        "reason" : [ {
          "{{#primary}}" : "{{%diagnoses.where(seq_num = 1).first()}}",
          "{{?}}" : {
            "use" : [ {
              "coding" : [ {
                "system" : "http://hl7.org/fhir/encounter-reason-use",
                "code" : "AD",
                "display" : "Admission diagnosis"
              } ]
            } ],
            "value" : [ {
              "reference" : "{{mpp:createFhirReferenceWithHashedId('Condition', %primary.hadm_id.toString() & %primary.seq_num.toString())}}"
            } ]
          }
        } ],
        "diagnosis" : {
          "{{#cond}}" : "{{%diagnoses}}",
          "{{*}}" : {
            "condition" : [ {
              "reference" : "{{mpp:createFhirReferenceWithHashedId('Condition', %cond.hadm_id.toString() & %cond.seq_num.toString())}}"
            } ],
            "use" : [ {
              "coding" : [ {
                "system" : "http://terminology.hl7.org/CodeSystem/diagnosis-role",
                "code" : "billing",
                "display" : "Billing"
              } ]
            } ]
          }
        },
        "location" : {
          "{{#transfer}}" : "{{%transfers.where($this.eventtype != 'discharge' and $this.careunit.exists())}}",
          "{{*}}" : {
            "location" : {
              "reference" : "{{mpp:createFhirReferenceWithHashedId('Location', %transfer.careunit).reference}}",
              "display" : "{{%transfer.careunit}}"
            },
            "status" : "completed",
            "period" : {
              "start" : "{{%transfer.intime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')}}",
              "end" : "{{? %transfer.outtime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')}}"
            }
          }
        },
        "extension" : {
          "{{#insuranceVar}}" : "{{insurance}}",
          "{{?}}" : [ {
            "url" : "https://mimic.mit.edu/fhir/StructureDefinition/ext-insurance",
            "valueString" : "{{%insuranceVar}}"
          } ]
        }
      }
    }
  } ]
}
