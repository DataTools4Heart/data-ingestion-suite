{
  "id" : "procedures-icd",
  "url" : "https://mimic.mit.edu/fhir/mappings/procedures-icd",
  "name" : "procedures-icd",
  "title" : "Mapping of entries in 'procedures_icd' table joined with 'd_icd_procedures' table restructured as FHIR concept map in MIMIC-IV v3.1 dataset into FHIR Procedure resources. ICD-9-CM (volume 3) procedure codes are translated to ICD-10-PCS through the CMS GEM (exact single-code entries preferred, otherwise the first choice of the first combination scenario); rows whose ICD-9-CM code has no GEM equivalent are skipped because HFR-Procedure requires an ICD-10-PCS coding.",
  "isDraft" : false,
  "source" : [ {
    "alias" : "procedures",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-procedures-icd",
    "joinOn" : [ "icd_version", "icd_code" ]
  }, {
    "alias" : "icdConceptMap",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-d-icd-diagnoses",
    "joinOn" : [ "icd_version", "icd_code" ]
  } ],
  "context" : {
    "icd9to10Map" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/mimic/icd9toicd10pcsgem.csv"
    }
  },
  "variable" : [ {
    "name" : "pcsConcept",
    "language" : "text/fhirpath",
    "expression" : "iif(icd_version = 9, mpp:getConcept(%icd9to10Map, icd_code).where(no_map='0' and combination='0').last().nav:orElse(mpp:getConcept(%icd9to10Map, icd_code).where(no_map='0' and scenario='1' and choice_list='1').first()), {})"
  }, {
    "name" : "icdDisplay",
    "language" : "text/fhirpath",
    "expression" : "%icdConceptMap.first().long_title"
  } ],
  "mapping" : [ {
    "precondition" : {
      "name" : "icd10PcsCodeExists",
      "language" : "text/fhirpath",
      "expression" : "icd_version = 10 or %pcsConcept.exists()"
    },
    "expression" : {
      "name" : "procedure-mapping",
      "language" : "application/fhir-template+json",
      "value" : {
        "resourceType" : "Procedure",
        "id" : "{{mpp:getHashedId('Procedure', hadm_id.toString() & seq_num.toString())}}",
        "meta" : {
          "source" : "{{%sourceSystem.sourceUri}}",
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Procedure" ]
        },
        "identifier" : [ {
          "use" : "official",
          "system" : "{{%sourceSystem.sourceUri}}/fhir/procedures_icd_ids",
          "value" : "{{hadm_id.toString() & '-' & seq_num.toString()}}"
        } ],
        "category" : [ {
          "coding" : [ {
            "system" : "http://snomed.info/sct",
            "code" : "71388002",
            "display" : "Procedure (procedure)"
          } ]
        } ],
        "status" : "completed",
        "subject" : "{{mpp:createFhirReferenceWithHashedId('Patient', subject_id.toString())}}",
        "encounter" : "{{mpp:createFhirReferenceWithHashedId('Encounter', hadm_id.toString())}}",
        "code" : {
          "coding" : [ {
            "{{#isIcd10}}" : "{{iif(icd_version = 10, true, {})}}",
            "{{?}}" : {
              "system" : "http://hl7.org/fhir/sid/icd-10-pcs",
              "code" : "{{icd_code}}",
              "display" : "{{? %icdDisplay}}"
            },
            "@sliceName" : "icdCode"
          }, {
            "{{#isIcd9}}" : "{{iif(icd_version = 9, true, {})}}",
            "{{?}}" : {
              "system" : "http://hl7.org/fhir/sid/icd-9-cm",
              "code" : "{{iif(icd_code.length() > 2, icd_code.substring(0,2) & '.' & icd_code.substring(2), icd_code)}}",
              "display" : "{{? %icdDisplay}}"
            }
          }, {
            "{{#gemConcept}}" : "{{%pcsConcept}}",
            "{{?}}" : {
              "system" : "http://hl7.org/fhir/sid/icd-10-pcs",
              "code" : "{{%gemConcept.icd10cm}}"
            },
            "@sliceName" : "icdCode"
          } ],
          "text" : "{{? %icdDisplay}}"
        },
        "occurrenceDateTime" : "{{chartdate}}",
        "extension" : [ {
          "url" : "https://mimic.mit.edu/fhir/StructureDefinition/ext-procedure-seq-num",
          "valueInteger" : "{{seq_num}}"
        } ]
      }
    }
  } ]
}
