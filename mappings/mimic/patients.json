{
  "id" : "patients",
  "url" : "https://mimic.mit.edu/fhir/mappings/patients",
  "name" : "patients",
  "title" : "Mapping of entries in 'patients' table in MIMIC-IV v3.1 dataset into FHIR Patient resources. Marital status, race (HFR-Ethnicity extension) and language are taken from the patient's most recent admission.",
  "isDraft" : false,
  "source" : [ {
    "alias" : "patients",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-patients",
    "joinOn" : [ "subject_id" ]
  }, {
    "alias" : "admissions",
    "url" : "https://mimic.mit.edu/fhir/StructureDefinition/Ext-admissions",
    "joinOn" : [ "subject_id" ]
  } ],
  "context" : {
    "raceToEthnicityMap" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/mimic/race-to-ethnicity-concept-map.csv"
    },
    "languageMap" : {
      "category" : "concept-map",
      "url" : "$CONTEXT_REPO/mimic/language-to-bcp47-concept-map.csv"
    }
  },
  "variable" : [ {
    "name" : "lastAdmission",
    "language" : "text/fhirpath",
    "expression" : "%admissions.aggregate(iif($total.empty(), $this, iif($this.admittime > $total.admittime, $this, $total)))"
  } ],
  "mapping" : [ {
    "expression" : {
      "name" : "patients-mapping",
      "language" : "application/fhir-template+json",
      "value" : {
        "resourceType" : "Patient",
        "id" : "{{mpp:getHashedId('Patient', subject_id.toString())}}",
        "meta" : {
          "source" : "{{%sourceSystem.sourceUri}}",
          "profile" : [ "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Patient" ]
        },
        "identifier" : [ {
          "use" : "official",
          "system" : "{{%sourceSystem.sourceUri}}/fhir/subject_ids",
          "value" : "{{subject_id.toString()}}"
        } ],
        "active" : true,
        "gender" : "{{iif(gender='M', 'male', 'female')}}",
        "birthDate" : "{{(anchor_year - anchor_age)}}",
        "deceasedDateTime" : "{{? iif(%admissions.where(deathtime.exists()).exists(), %admissions.where(deathtime.exists()).first().deathtime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00'), dod)}}",
        "maritalStatus" : {
          "{{#ms}}" : "{{%lastAdmission.marital_status}}",
          "{{?}}" : {
            "coding" : [ "{{? trms:translateToCoding(%ms, 'https://mimic.mit.edu/fhir/CodeSystem/marital-status','https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/marital-status-to-hl7')}}" ],
            "text" : "{{%ms}}"
          }
        },
        "communication" : [ {
          "{{#lng}}" : "{{iif(%lastAdmission.language.exists(), mpp:getConcept(%languageMap, %lastAdmission.language).first(), {})}}",
          "{{?}}" : {
            "language" : {
              "coding" : [ {
                "system" : "urn:ietf:bcp:47",
                "code" : "{{%lng.target_code}}",
                "display" : "{{%lng.target_display}}"
              } ],
              "text" : "{{%lastAdmission.language}}"
            },
            "preferred" : true
          }
        } ],
        "extension" : [ {
          "{{#eth}}" : "{{iif(%lastAdmission.race.exists(), mpp:getConcept(%raceToEthnicityMap, %lastAdmission.race).first(), {})}}",
          "{{?}}" : {
            "url" : "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Ethnicity",
            "valueCodeableConcept" : {
              "coding" : [ {
                "system" : "http://snomed.info/sct",
                "code" : "{{%eth.target_code}}",
                "display" : "{{%eth.target_display}}"
              } ],
              "text" : "{{%lastAdmission.race}}"
            }
          }
        } ]
      }
    }
  } ]
}
