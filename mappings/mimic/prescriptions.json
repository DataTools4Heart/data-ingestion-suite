{
  "id": "prescriptions",
  "url": "https://mimic.mit.edu/fhir/mappings/prescriptions",
  "name": "prescriptions",
  "title": "Mapping of prescriptions in 'prescriptions' table in MIMIC-IV v3.1 dataset into FHIR MedicationRequest resources (HFR-MedicationRequest). Medication codes: NDC from the source, RxNorm ingredient resolved offline (ndcToMedDetails), ATC via the rx-norm-to-atc ConceptMap.",
  "isDraft": false,
  "source": [
    {
      "alias": "source",
      "url": "https://mimic.mit.edu/fhir/StructureDefinition/Ext-prescriptions",
      "joinOn": []
    }
  ],
  "context": {
    "ndcToMedDetails": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/mimic/ndcToMedDetails.csv"
    }
  },
  "variable": [
    {
      "name": "doseUnit",
      "language": "text/fhirpath",
      "expression": "iif(dose_unit_rx.exists() and dose_unit_rx.trim() != '', trms:translateToCoding(dose_unit_rx.trim(), 'https://mimic.mit.edu/fhir/CodeSystem/medication-dose-units', 'https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/medication-dose-to-orderable-drug-form').first(), {})"
    },
    {
      "name": "stime",
      "language": "text/fhirpath",
      "expression": "starttime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')"
    },
    {
      "name": "etime",
      "language": "text/fhirpath",
      "expression": "stoptime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss', '-05:00')"
    },
    {
      "name": "ndcCode",
      "language": "text/fhirpath",
      "expression": "iif(ndc.exists() and ndc.toString().trim() != '' and ndc.toString() != '0' and ndc.toString() != '00000000000', iif(ndc.toString().length() = 11, ndc.toString(), iif(ndc.toString().length() = 10, '0' & ndc.toString(), iif(ndc.toString().length() = 9, '00' & ndc.toString(), iif(ndc.toString().length() = 8, '000' & ndc.toString(), iif(ndc.toString().length() = 7, '0000' & ndc.toString(), iif(ndc.toString().length() = 6, '00000' & ndc.toString(), iif(ndc.toString().length() = 5, '000000' & ndc.toString(), ndc.toString()))))))), {})"
    },
    {
      "name": "ndcDetails",
      "language": "text/fhirpath",
      "expression": "iif(%ndcCode.exists(), mpp:getConcept(%ndcToMedDetails, %ndcCode).first(), {})"
    },
    {
      "name": "atcCodings",
      "language": "text/fhirpath",
      "expression": "iif(%ndcDetails.activeIngredientRxcui.exists() and %ndcDetails.activeIngredientRxcui != '', trms:translateToCoding(%ndcDetails.activeIngredientRxcui, 'http://www.nlm.nih.gov/research/umls/rxnorm', 'https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/rx-norm-to-atc'), {})"
    }
  ],
  "mapping": [
    {
      "expression": {
        "name": "prescriptions-mapping",
        "language": "application/fhir-template+json",
        "value": {
          "resourceType": "MedicationRequest",
          "id": "{{mpp:getHashedId('MedicationRequest', pharmacy_id.toString() & gsn.toString() & ndc.toString() & formulary_drug_cd.toString())}}",
          "meta": {
            "source": "{{%sourceSystem.sourceUri}}",
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-MedicationRequest"
            ]
          },
          "identifier": [
            {
              "system": "{{%sourceSystem.sourceUri}}/fhir/prescription_ids",
              "value": "{{pharmacy_id.toString() & '-' & gsn.toString() & '-' & ndc.toString() & '-' & formulary_drug_cd.toString()}}"
            }
          ],
          "status": "completed",
          "intent": "order",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/medicationrequest-category",
                  "code": "inpatient",
                  "display": "Inpatient"
                }
              ]
            },
            {
              "coding": [
                {
                  "system": "https://mimic.mit.edu/fhir/CodeSystem/medication-types",
                  "code": "{{drug_type}}"
                }
              ]
            }
          ],
          "medication": {
            "concept": {
              "{{#ndcForConcept}}": "{{%ndcCode}}",
              "{{?}}": {
                "coding": [
                  {
                    "{{#ndcVar}}": "{{%ndcCode}}",
                    "{{?}}": {
                      "system": "http://hl7.org/fhir/sid/ndc",
                      "code": "{{%ndcVar}}",
                      "display": "{{drug}}"
                    }
                  },
                  {
                    "{{#rxn}}": "{{%ndcDetails.where(activeIngredientRxcui.exists() and activeIngredientRxcui != '')}}",
                    "{{?}}": {
                      "system": "http://www.nlm.nih.gov/research/umls/rxnorm",
                      "code": "{{%rxn.activeIngredientRxcui}}",
                      "display": "{{? %rxn.activeIngredientName}}"
                    }
                  },
                  {
                    "{{#atc}}": "{{%atcCodings}}",
                    "{{*}}": {
                      "system": "http://www.whocc.no/atc",
                      "code": "{{%atc.code}}",
                      "display": "{{? %atc.display}}",
                      "@sliceName": "atcCode"
                    }
                  }
                ],
                "text": "{{drug}}"
              }
            },
            "reference": {
              "reference": "{{mpp:createFhirReferenceWithHashedId('Medication', drug & gsn.toString() & ndc.toString() & formulary_drug_cd).reference}}",
              "display": "{{drug}}"
            }
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject_id.toString())}}",
          "encounter": "{{? mpp:createFhirReferenceWithHashedId('Encounter', hadm_id.toString())}}",
          "authoredOn": "{{? %stime}}",
          "dosageInstruction": [
            {
              "text": "{{? iif(dose_val_rx.exists() and dose_unit_rx.exists(), dose_val_rx & ' ' & dose_unit_rx & iif(route.exists(), ' ' & route, ''), {})}}",
              "timing": {
                "repeat": {
                  "boundsPeriod": {
                    "{{#isPeriodExist}}": "{{(%stime | %etime).first()}}",
                    "{{?}}": {
                      "start": "{{? iif(%stime.exists() and %etime.exists() and %stime > %etime, %etime, %stime)}}",
                      "end": "{{? iif(%stime.exists() and %etime.exists() and %stime > %etime, %stime, %etime)}}"
                    }
                  },
                  "frequency": "{{? doses_per_24_hrs.where($this > 0)}}",
                  "period": "{{? iif(doses_per_24_hrs.where($this > 0).exists(), 1, {})}}",
                  "periodUnit": "{{? iif(doses_per_24_hrs.where($this > 0).exists(), 'd', {})}}"
                }
              },
              "route": {
                "{{#rt}}": "{{route}}",
                "{{?}}": {
                  "coding": [
                    {
                      "system": "https://mimic.mit.edu/fhir/CodeSystem/medication-route-codes",
                      "code": "{{%rt}}",
                      "display": "{{%rt}}"
                    },
                    "{{? trms:translateToCoding(%rt, 'https://mimic.mit.edu/fhir/CodeSystem/medication-route-codes', 'https://github.com/srdc/mimic-iv-to-fhir/fhir/ConceptMap/medication-route-codes-to-snomed')}}"
                  ],
                  "text": "{{%rt}}"
                }
              },
              "doseAndRate": [
                {
                  "{{#dsq}}": "{{iif(dose_val_rx.contains('-'), {}, dose_val_rx.replace(',','').utl:trim().toDecimal())}}",
                  "{{?}}": {
                    "doseQuantity": {
                      "value": "{{%dsq}}",
                      "system": "{{? %doseUnit.system}}",
                      "code": "{{? %doseUnit.code}}",
                      "unit": "{{? (%doseUnit.code | dose_unit_rx).first()}}"
                    }
                  }
                },
                {
                  "{{#isRange}}": "{{iif(dose_val_rx.contains('-') and dose_val_rx.split('-').select($this.replace(',','').utl:trim().toDecimal()).count() = 2, true, {})}}",
                  "{{?}}": {
                    "doseRange": {
                      "low": {
                        "value": "{{dose_val_rx.split('-').select($this.replace(',','').utl:trim().toDecimal()).aggregate(iif($total.empty(), $this, iif($this < $total, $this, $total)))}}",
                        "system": "{{? %doseUnit.system}}",
                        "code": "{{? %doseUnit.code}}",
                        "unit": "{{? (%doseUnit.code | dose_unit_rx).first()}}"
                      },
                      "high": {
                        "value": "{{dose_val_rx.split('-').select($this.replace(',','').utl:trim().toDecimal()).aggregate(iif($total.empty(), $this, iif($this < $total, $total, $this)))}}",
                        "system": "{{? %doseUnit.system}}",
                        "code": "{{? %doseUnit.code}}",
                        "unit": "{{? (%doseUnit.code | dose_unit_rx).first()}}"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
