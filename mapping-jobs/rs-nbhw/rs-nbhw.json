{
  "id" : "rs-nbhw",
  "name" : "rs-nbhw",
  "description" : "",
  "sourceSettings" : {
    "rs-source" : {
      "jsonClass" : "FileSystemSourceSettings",
      "name" : "rs-source",
      "sourceUri" : "https://datatools4heart.eu/data-ingestion-suite/rs-data",
      "dataFolderPath" : "test-data/rs",
      "asStream" : false
    }
  },
  "sinkSettings" : {
    "jsonClass" : "FhirRepositorySinkSettings",
    "fhirRepoUrl" : "http://onfhir:8080/fhir",
    "returnMinimal" : true
  },
  "mappings" : [ {
    "name" : "cause-of-death-mapping",
    "mappingRef" : "https://datatools4heart.eu/fhir/mappings/rs-nbhw/cause-of-death-mapping",
    "sourceBinding" : {
      "source" : {
        "jsonClass" : "FileSystemSource",
        "path" : "nbhw/death.txt",
        "contentType" : "tsv",
        "options" : { },
        "sourceRef" : "rs-source"
      }
    }
  }, {
    "name" : "encounter-mapping",
    "mappingRef" : "https://datatools4heart.eu/fhir/mappings/rs-nbhw/encounter-mapping",
    "sourceBinding" : {
      "source" : {
        "jsonClass" : "FileSystemSource",
        "path" : "nbhw/VisitHospitalization.txt",
        "contentType" : "tsv",
        "options" : { },
        "sourceRef" : "rs-source"
      }
    }
  }, {
    "name" : "medication-mapping",
    "mappingRef" : "https://datatools4heart.eu/fhir/mappings/rs-nbhw/medication-mapping",
    "sourceBinding" : {
      "source" : {
        "jsonClass" : "FileSystemSource",
        "path" : "nbhw/dispenseddrugs.txt",
        "contentType" : "tsv",
        "options" : {
          "distinct" : "true"
        },
        "preprocessSql" : "SELECT *,\r\n  CASE\r\n    WHEN frequency IS NULL OR frequency <= 0 THEN NULL\r\n    WHEN frequency = round(frequency)        THEN CAST(frequency AS BIGINT)\r\n    ELSE CAST(round(frequency * 4) AS BIGINT)\r\n  END AS freq_int,\r\n  CASE\r\n    WHEN frequency IS NULL OR frequency <= 0 THEN NULL\r\n    WHEN frequency = round(frequency)        THEN period\r\n    ELSE period * 4\r\n  END AS period_scaled\r\nFROM source",
        "sourceRef" : "rs-source"
      }
    }
  }, {
    "name" : "procedure-mapping",
    "mappingRef" : "https://datatools4heart.eu/fhir/mappings/rs-nbhw/procedure-mapping",
    "sourceBinding" : {
      "source" : {
        "jsonClass" : "FileSystemSource",
        "path" : "nbhw/Procedure.txt",
        "contentType" : "tsv",
        "options" : {
          "distinct" : "true"
        },
        "sourceRef" : "rs-source"
      }
    }
  } ],
  "dataProcessingSettings" : {
    "saveErroneousRecords" : false,
    "archiveMode" : "off"
  },
  "useFhirSinkAsIdentityService" : false
}