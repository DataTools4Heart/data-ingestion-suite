{
  "id" : "amc-csv-test",
  "name" : "amc-csv-test",
  "description" : "Test the AMC mappings against the small CSV test data in test-data/amc-csv. Same source bindings and preprocessSql as amc-parquet, without the year/month/remainder batching. All CSV sources set inferSchema=false: with a preprocessSql, Ignifyr would otherwise let Spark guess the column types (e.g. LOINC code 2823-3 read as a date) instead of using the schema.",
  "sourceSettings" : {
    "amc-csv" : {
      "jsonClass" : "FileSystemSourceSettings",
      "name" : "amc-csv",
      "sourceUri" : "https://datatools4heart.eu/data-ingestion-suite/amc-data",
      "dataFolderPath" : "test-data/amc-csv",
      "asStream" : false
    }
  },
  "sinkSettings" : {
    "jsonClass" : "FhirRepositorySinkSettings",
    "fhirRepoUrl" : "http://localhost:8080/fhir",
    "returnMinimal" : true
  },
  "mappings" : [
    {
      "name" : "vital-sign-bp-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/vital-sign-bp-mapping",
      "sourceBinding" : {
        "VitalSignBp" : {
          "jsonClass" : "FileSystemSource",
          "path" : "BloodPressure.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "vital-sign-length-weight-bmi-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/vital-sign-length-weight-bmi-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "LengthWeightBMI.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "preprocessSql" : "select Pseudo_id,Patientcontactid,MeetDatum,MAX(CASE WHEN LOINCcode = '8302-2' THEN ValueQuantity END) AS Height_cm,MAX(CASE WHEN LOINCcode = '29463-7' THEN ValueQuantity END) AS Weight_kg,MAX(CASE WHEN LOINCcode = '89270-3' THEN ValueQuantity END) AS BMI FROM source GROUP BY Pseudo_id,Patientcontactid,MeetDatum",
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "vital-sign-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/vital-sign-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "VitalSigns.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "laboratory-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/laboratory-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Laboratory.csv",
          "contentType" : "csv",
          "options" : {
            "distinct" : "true",
            "inferSchema" : "false"
          },
          "preprocessSql" : "select * from source where LOINC_code != '89579-7' and LOINC_code != '10839-9'",
          "sourceRef" : "amc-csv"
        },
        "encounters" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Encounters.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "ecg-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/ecg-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "ECG.csv",
          "contentType" : "csv",
          "options" : {
            "distinct" : "true",
            "inferSchema" : "false"
          },
          "preprocessSql" : "select count(*) as count, Pseudo_id, EcgMetingId,\r\narray_agg(EcgAfnameDatumTijd) as EcgAfnameDatumTijd,\r\narray_agg(ValueQuantity) as ValueQuantity,\r\narray_agg(LOINCcode) as LOINCcode,\r\narray_agg(LOINCdisplay) as LOINCdisplay\r\nfrom source \r\nwhere ValueQuantity != 0 AND NOT (LOINCcode = '8633-0' AND ValueQuantity > 300)\r\ngroup by Pseudo_id, EcgMetingId",
          "sourceRef" : "amc-csv"
        },
        "encounters" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Encounters.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "preprocessSql" : "select Pseudo_id,PatientContactId,PrimaryICDcode,StartDate,EndDate from encounters;",
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "patient-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/patient-mapping",
      "sourceBinding" : {
        "patient" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Patient.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        },
        "death" : {
          "jsonClass" : "FileSystemSource",
          "path" : "DeathRegistry.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "smoking-status-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/smoking-status-mapping",
      "sourceBinding" : {
        "SmokingStatus" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Tabakgebruik.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "cause-of-death-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/cause-of-death-mapping",
      "sourceBinding" : {
        "CauseOfDeath" : {
          "jsonClass" : "FileSystemSource",
          "path" : "DeathRegistry.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "condition-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/condition-mapping",
      "sourceBinding" : {
        "Condition" : {
          "jsonClass" : "FileSystemSource",
          "path" : "MedischeDiagnose.csv",
          "contentType" : "csv",
          "options" : {
            "distinct" : "true",
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "encounter-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/encounter-mapping",
      "sourceBinding" : {
        "Encounter" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Encounters.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "medication-administration-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/medication-administration-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "MedicationAdministration.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "preprocessSql" : "select * \nfrom source\nwhere ATCCode != '' and AdministeredAmount IS NOT NULL",
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "med-prescription-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/med-prescription-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "MedicationPrescription.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "preprocessSql" : "select DISTINCT * \nfrom source\nwhere StartDate > '1900-01-01'",
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "nyha-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/nyha-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "NYHA.csv",
          "contentType" : "csv",
          "options" : {
            "distinct" : "true",
            "inferSchema" : "false"
          },
          "preprocessSql" : "select *\r\nfrom source \r\nwhere nyha IN (1, 2, 3, 4)",
          "sourceRef" : "amc-csv"
        },
        "encounters" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Encounters.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "echo-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/echo-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Echocardiography.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "preprocessSql" : "select count(*) as count, pseudo_id, Accessionnummer,\r\narray_agg(Onderzoeksdatum) as Onderzoeksdatum,\r\narray_agg(ValueQuantity) as ValueQuantity,\r\narray_agg(UNIT) as UNIT,\r\narray_agg(LOINCcode) as LOINCcode,\r\narray_agg(LOINCdisplay) as LOINCdisplay\r\nfrom source \r\nwhere LOINCcode is not null\r\ngroup by pseudo_id, Accessionnummer",
          "sourceRef" : "amc-csv"
        },
        "encounters" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Encounters.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    },
    {
      "name" : "procedure-mapping",
      "mappingRef" : "https://datatools4heart.eu/fhir/mappings/amc/procedure-mapping",
      "sourceBinding" : {
        "source" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Procedures.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "preprocessSql" : "select DISTINCT VerrichtingId, pseudo_id, Verrichtingdatum, ICD10PCS, ProcedureCategory from source where ICD10PCS IS NOT NULL",
          "sourceRef" : "amc-csv"
        },
        "encounters" : {
          "jsonClass" : "FileSystemSource",
          "path" : "Encounters.csv",
          "contentType" : "csv",
          "options" : {
            "inferSchema" : "false"
          },
          "sourceRef" : "amc-csv"
        }
      }
    }
  ],
  "dataProcessingSettings" : {
    "saveErroneousRecords" : false,
    "archiveMode" : "off"
  },
  "useFhirSinkAsIdentityService" : false
}
